{
  "name": "@alpaca/ts-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Alpaca Markets API (browser + Node.js)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build:wasm": "cd .. && wasm-pack build crates/alpaca-web-sys --target web --out-dir ../../ts-sdk/wasm",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist",
    "wasm"
  ]
}
